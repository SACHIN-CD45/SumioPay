# ==============================================================================
# SumioPay Git Ignore Policy
# Protects private secrets, credentials, build artifacts, and dependencies.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secret Credentials (NEVER COMMIT SENSITIVE SECRETS)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.local
frontend/.env.production
frontend/.env.development

# Allow tracked safe examples
!.env.example
!backend/.env.example
!frontend/.env.example

# Private Keys, Certificates, and Keystores
*.pem
*.key
*.cert
*.crt
*.p12
*.jks
*.keystore
id_rsa
id_rsa.pub

# Cloud / Vendor Secrets
google-services.json
GoogleService-Info.plist
firebase-adminsdk*.json

# ------------------------------------------------------------------------------
# 2. Dependencies
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
packages/*/node_modules/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# 3. Production Build Artifacts & Caches
# ------------------------------------------------------------------------------
dist/
*/dist/
build/
*/build/
.vite/
*.tsbuildinfo
.eslintcache

# ------------------------------------------------------------------------------
# 4. Logs & Diagnostics
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. OS & IDE Workspace Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 6. Android Gradle Temporary Files (Keep compiled release downloads)
# ------------------------------------------------------------------------------
.gradle/
android-listener-apk/.gradle/
android-listener-apk/build/
local.properties
