# ==============================================================================
# SumioPay Monorepo - Environment Template (.env.example)
# Copy this file to .env and configure your environment variables.
# ==============================================================================

NODE_ENV=production
PORT=8090
BASE_URL=https://apipay.sumiotech.in
API_BASE_URL=https://apipay.sumiotech.in/api

# Database Connections
MONGO_URI=mongodb://127.0.0.1:27017/sumiopay_saas
REDIS_URL=redis://127.0.0.1:6379

# JWT Cryptographic Secrets (Generate unique 64-char keys for production)
JWT_SECRET=your_master_jwt_secret_change_me_in_production
JWT_ACCESS_SECRET=your_access_token_secret_change_me_in_production
JWT_REFRESH_SECRET=your_refresh_token_secret_change_me_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=sumiopay.sumiotech.in
JWT_AUDIENCE=sumiopay-clients

# Initial Master SuperAdmin (Created upon first server start)
SUPERADMIN_EMAIL=admin@sumiopay.com
SUPERADMIN_PASSWORD=Admin@SumioPay2026!
SUPERADMIN_NAME=SumioPay Master Admin

# Security & CORS
CORS_ORIGINS=https://sumiopay.sumiotech.in,https://www.sumiopay.sumiotech.in,http://localhost:5173
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
ORDER_TTL_MINUTES=15
