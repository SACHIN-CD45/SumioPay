# ==============================================================================
# SUMIOPAY PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=5000

# Base Service URLs
BASE_URL=https://pay.sumiotech.com
FRONTEND_URL=https://pay.sumiotech.com
CENTRAL_BACKEND_URL=https://pay.sumiotech.com

# Database Connection (MongoDB Replica Set recommended for transactions)
MONGO_URI=mongodb://mongodb:27017/sumiopay

# Cache & Message Broker (Redis / BullMQ)
REDIS_URL=redis://redis:6379

# Cryptographic Secrets
JWT_SECRET=replace_with_at_least_64_character_random_hex_string
UPI_WEBHOOK_SECRET=replace_with_strong_webhook_signature_secret

# Default Merchant Config (Fallback for legacy apps)
MERCHANT_UPI_ID=pay.sumio@okhdfcbank
MERCHANT_NAME=SumioTech

# Android APK Listener Expiry & Safety Limits
ORDER_EXPIRY_MINUTES=15
MAX_PAISE_OFFSET=99
MIN_PAISE_OFFSET=1
ENABLE_SMS_SPOOF_DETECTION=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
